# =====================================================================
# Null-Void Engine - Environment Variable Template (.env.example)
# Copy this file to .env and adjust the values before starting:
#   cp .env.example .env
# =====================================================================

# ===== Access & Server =====
CREDENTIALS=admin:admin               # Format: username:password (comma-separated for multiple users)
SECRET_KEY=                           # Application secret key (leave blank for automatic secure generation)
HOST=0.0.0.0                          # Bind address
FLASK_PORT=5000                       # Web and WebSocket port
DEBUG=false                           # Set to true for development debugging
SERVER_NAME=NullVoid                  # Visible server name

# ===== Persistent Storage (Host Paths) =====
# Specify absolute paths on the host system to store persistent application data:
DATA_HOST_DIR=/home/user/Null-Void-Data/app
SCRAPER_HOST_DIR=/home/user/Null-Void-Data/scraper
CERTS_HOST_DIR=/home/user/Null-Void-Data/certs
SECRETS_HOST_DIR=/home/user/Null-Void-Data/.secrets

# ===== Local Execution (Non-Docker Mode) =====
# Paths used only when executing services directly on the host without Docker:
DATA_DIR=/home/user/Null-Void-Data/app
SCRAPER_DIR=/home/user/Null-Void-Data/scraper
#DB_PATH=                              # Custom path to manager.db

# ===== HTTPS / TLS Encryption =====
USE_HTTPS=false                       # Enable TLS encryption (requires valid cert/key files)
CERT_FILE="/app/certs/cert.pem"       # Container certificate path
KEY_FILE="/app/certs/key.pem"         # Container private key path

# ===== Scraper Service =====
SCRAPER_API_KEY=change-this-secret-key    # Shared internal authentication token (X-Internal-Token)
SCRAPER_BASE_URL=http://127.0.0.1:5001    # Scraper service endpoint called by the main service
ENGINE_BASE_URL=http://127.0.0.1:5000     # Main engine endpoint called by the scraper service
AUTO_SCRAPE_ENABLED=false                 # Enable background scraping tasks

# ===== AI Service (Ollama & External Providers) =====
OLLAMA_HOST=http://127.0.0.1:11434        # Local Ollama endpoint

# ===== Mobile Push Notifications (Firebase FCM) =====
FCM_SECRET_KEY=                           # 256-bit AES key in base64 for payload encryption
#FCM_CREDENTIALS_PATH=/app/.secrets/firebase_key.json

# ===== Telemetry =====
#MONITOR_DISKS=/, /app/data               # Comma-separated mount points to monitor

# ===== Outgoing Mail Server (SMTP) =====
#ALIAS_SMTP_HOST=smtp.gmail.com
#ALIAS_SMTP_PORT=587

# ===== Scraper Notifications via Telegram =====
TELEGRAM_ENABLED=false
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# ===== Video Transcoding & Caching =====
#VIDEO_CACHE_MAX_MB=5120
#VIDEO_PREWARM_QUALITY=720p
#VIDEO_TRANSCODE_TIMEOUT=900